# RWA Mobile runtime configuration.
# Copy to .env (git-ignored) and fill in. EXPO_PUBLIC_* values are inlined into the JS bundle at
# build time, so never put secrets here. For EAS builds, set the same variables in the EAS
# environment. Each value can also be given in app config `extra` (apiUrl, walletConnectProjectId,
# contracts.{rwaToken,marketplace,staking,governance}, mainnetContracts.{...}); env vars win.
#
# The app refuses to start (shows a configuration error) if a REQUIRED value is missing or invalid.

# REQUIRED: backend base URL, without the trailing /api (https required in release builds)
EXPO_PUBLIC_API_URL=

# REQUIRED: WalletConnect / Reown project ID (https://cloud.reown.com)
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# REQUIRED: contract addresses on the active network (Avalanche Fuji)
EXPO_PUBLIC_RWA_TOKEN_ADDRESS=
EXPO_PUBLIC_MARKETPLACE_ADDRESS=
EXPO_PUBLIC_STAKING_ADDRESS=
# Optional
EXPO_PUBLIC_GOVERNANCE_ADDRESS=

# Optional: Avalanche C-Chain mainnet addresses (not the active network yet)
EXPO_PUBLIC_MAINNET_RWA_TOKEN_ADDRESS=
EXPO_PUBLIC_MAINNET_MARKETPLACE_ADDRESS=
EXPO_PUBLIC_MAINNET_STAKING_ADDRESS=
EXPO_PUBLIC_MAINNET_GOVERNANCE_ADDRESS=
